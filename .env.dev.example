# DEV environment — copy to .env.dev and fill in real values.
# Used by: npm run dev:dev | build:dev (then npm start serves that build)
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
# Values in .env.dev override .env/.env.local; without the file, the process environment is used.

# Required: server API base URL, including /api (e.g. https://dev-api.example.com/api)
NEXT_PUBLIC_API_URL=

# Optional
# NEXT_PUBLIC_APP_NAME=DX Enterprise
